msgid_plural "{n} more on none of the scanned drives"
msgstr[0] "{n} más en ninguna de las unidades leídas"
msgstr[1] "{n} más en ninguna de las unidades leídas"

msgid "Also the render files of its sequences"
msgstr "También los archivos de render de sus secuencias"

msgid "Copy"
msgstr "Copiar"

