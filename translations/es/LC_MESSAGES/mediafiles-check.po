msgid_plural "{n} new files"
msgstr[0] "{n} archivo nuevo"
msgstr[1] "{n} archivos nuevos"

msgid "Folders are renamed for Media Composer right now. Rename them back first (Check DBs › New databases) – until then no other folders are renamed and no databases are rewritten."
msgstr "Ahora hay carpetas renombradas para Media Composer. Devuélveles primero su nombre (Comprobar BD › Bases nuevas); hasta entonces no se renombran otras carpetas ni se reescriben bases de datos."

msgid "Rewrite databases waits until the renamed folders are renamed back (Check DBs › New databases)."
msgstr "Reescribir bases espera a que las carpetas renombradas recuperen su nombre (Comprobar BD › Bases nuevas)."

msgid "{n} folder merges, {} in own folders"
msgid_plural "{n} folders merge, {} in own folders"
msgstr[0] "{n} carpeta se combina, {} en carpetas propias"
msgstr[1] "{n} carpetas se combinan, {} en carpetas propias"

